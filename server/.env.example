# =============================================================================
# School Hub - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# =============================================================================

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
DATABASE_URL="postgresql://username:password@localhost:5432/school_messaging?schema=public"
# Example for Docker: postgresql://sms_user:sms_password@postgres:5432/school_messaging?schema=public

# =============================================================================
# Redis Configuration (REQUIRED)
# =============================================================================
REDIS_URL="redis://localhost:6379"
# Example for Docker: redis://redis:6379

# =============================================================================
# JWT Secrets (REQUIRED - MUST BE 32+ CHARACTERS)
# =============================================================================
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-minimum-32-characters-long"
JWT_REFRESH_SECRET="your-different-refresh-secret-32-chars"

# Token expiration times
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,http://localhost:8085"
CLIENT_URL="http://localhost:8085"

# =============================================================================
# WebSocket Configuration
# =============================================================================
VITE_API_URL="http://localhost:3000"
VITE_WS_URL="http://localhost:3000"

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@schoolmessaging.com"
SMTP_FROM_NAME="School Messaging System"

# =============================================================================
# Storage Configuration (Optional - defaults to local)
# =============================================================================
# Options: 'local' or 's3'
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# S3 Configuration (required if STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=school-hub-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# Monitoring Configuration (Optional)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password

# =============================================================================
# SSL Configuration (Production only)
# =============================================================================
DOMAIN_NAME=localhost
CERTBOT_EMAIL=admin@example.com
