# Database
# For local development:
DATABASE_URL="postgresql://sms_user:sms_password_2026@127.0.0.1:5433/school_messaging?schema=public&connect_timeout=10"

# For production with connection pooling (adjust pool size based on your DB max_connections):
# PostgreSQL default max_connections = 100
# Recommended: connection_limit = 20 per instance, run 3-4 instances = 60-80 connections
# DATABASE_URL="postgresql://sms_user:sms_password_2026@127.0.0.1:5433/school_messaging?schema=public&connection_limit=20&pool_timeout=10"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets - CHANGE THESE IN PRODUCTION!
JWT_SECRET="school-msg-jwt-secret-change-in-production-2026"
JWT_REFRESH_SECRET="school-msg-refresh-secret-change-in-production-2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=3000
NODE_ENV=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Admin Dashboard WebSocket Namespace
ADMIN_WS_NAMESPACE=/admin

# Optional: SendGrid API Key for emails
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@yourdomain.com
