# ============================================
# School Hub - Load Balanced Configuration
# ============================================
# This config runs 3 backend instances behind Nginx load balancer

# Database (shared by all instances)
# Connection limit: 20 per instance × 3 instances = 60 connections
DB_USER=sms_user
DB_PASSWORD=sms_password_2026
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/school_messaging?schema=public&connection_limit=20&pool_timeout=10"

# Redis (shared pub/sub and cache)
REDIS_URL="redis://redis:6379"

# JWT Configuration
JWT_SECRET="your-production-jwt-secret-min-32-characters-long"
JWT_REFRESH_SECRET="your-production-refresh-secret-different-from-jwt"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
NODE_ENV=production
PORT=3000

# CORS Origins (your domain)
ALLOWED_ORIGINS="http://localhost,https://yourdomain.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# Admin Dashboard WebSocket Namespace
ADMIN_WS_NAMESPACE=/admin
