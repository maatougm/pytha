#!/bin/bash
# =============================================================================
# Pre-commit Hook for School Hub
# =============================================================================
# This hook runs before each commit to ensure code quality and security
# =============================================================================

set -e

echo "Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# =============================================================================
# 1. Check for sensitive files
# =============================================================================

echo "Checking for sensitive files..."

SENSITIVE_PATTERNS=(
    "\.env$"
    "\.env\.local$"
    "\.env\.production$"
    "\.pem$"
    "\.key$"
    "id_rsa"
    "id_dsa"
    "id_ecdsa"
    "id_ed25519"
    "\.p12$"
    "\.pfx$"
    "password"
    "secret"
)

for file in $STAGED_FILES; do
    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if echo "$file" | grep -qiE "$pattern"; then
            echo -e "${RED}ERROR: Attempting to commit potentially sensitive file: $file${NC}"
            echo "If this is intentional, use: git commit --no-verify"
            exit 1
        fi
    done
done

# =============================================================================
# 2. Check for large files (>10MB)
# =============================================================================

echo "Checking for large files..."

MAX_SIZE=$((10 * 1024 * 1024))  # 10MB in bytes

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        FILE_SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
        if [ "$FILE_SIZE" -gt "$MAX_SIZE" ]; then
            SIZE_MB=$(echo "scale=2; $FILE_SIZE / 1024 / 1024" | bc)
            echo -e "${YELLOW}WARNING: Large file detected: $file (${SIZE_MB}MB)${NC}"
            echo "Consider using Git LFS for large files."
        fi
    fi
done

# =============================================================================
# 3. Check for merge conflict markers
# =============================================================================

echo "Checking for merge conflict markers..."

for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        # Check for actual git conflict markers (not just lines of equals signs)
        if grep -qE "^<{7} |^={7}$|^>{7} " "$file" 2>/dev/null; then
            echo -e "${RED}ERROR: Merge conflict marker found in $file${NC}"
            exit 1
        fi
    fi
done

# =============================================================================
# 4. Run linting on staged files (if applicable)
# =============================================================================

# Check JavaScript/TypeScript files
JS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|vue)$' || true)
if [ -n "$JS_FILES" ] && [ -f "server/package.json" ]; then
    echo "Checking server linting..."
    cd server
    if npm run lint -- --max-warnings=0 2>/dev/null || true; then
        echo -e "${GREEN}Server linting passed${NC}"
    fi
    cd ..
fi

# =============================================================================
# 5. Check for console.log in production code
# =============================================================================

echo "Checking for debug statements..."

DEBUG_PATTERNS=(
    "console\.log"
    "console\.debug"
    "debugger;"
)

for file in $STAGED_FILES; do
    if [ -f "$file" ] && echo "$file" | grep -qE '\.(js|ts|vue|dart)$'; then
        for pattern in "${DEBUG_PATTERNS[@]}"; do
            if grep -q "$pattern" "$file" 2>/dev/null; then
                echo -e "${YELLOW}WARNING: Debug statement found in $file${NC}"
            fi
        done
    fi
done

# =============================================================================
# All checks passed
# =============================================================================

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
