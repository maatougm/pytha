# =============================================================================
# School Hub - PRODUCTION ENVIRONMENT VARIABLES
# =============================================================================
# ⚠️  CRITICAL: Keep this file secret! Never commit to git!
# 
# INSTRUCTIONS:
#   1. Copy this file: cp .env.production .env
#   2. Generate strong secrets (see commands below)
#   3. Fill in your actual domain and credentials
#   4. Validate with: ./scripts/validate-env.sh
#   5. Deploy with: docker-compose -f docker-compose.prod.yml up -d --build
# =============================================================================

# =============================================================================
# Domain & API Configuration (REQUIRED)
# =============================================================================

# Your production domain (e.g., schoolhub.com, app.schoolhub.com)
DOMAIN_NAME=yourdomain.com

# Full API URL that the Flutter web app will connect to
# Must be HTTPS in production! (e.g., https://api.yourdomain.com)
API_BASE_URL=http://localhost:3000

# WebSocket URL (usually same as API_BASE_URL, but can be different)
WS_BASE_URL=${API_BASE_URL}

# CORS allowed origins (comma-separated, include https://)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8085,http://localhost:8086,http://localhost:8087,http://127.0.0.1:8080,http://127.0.0.1:8087,http://localhost:5173,http://localhost:4173,http://localhost:3000,http://172.18.192.1:3000,exp://172.18.192.1:8081,exp://172.18.192.1:19000,exp://172.18.192.1:*

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================

DB_USER=sms_user

# Generate: openssl rand -base64 32
# IMPORTANT: Change from default! Must be strong!
DB_PASSWORD=sms_password_2026

# =============================================================================
# Redis Configuration (REQUIRED)
# =============================================================================

# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS_MIN

# =============================================================================
# JWT Secrets (CRITICAL - MUST BE 64+ CHARACTERS)
# =============================================================================
# Generate strong secrets:
#   openssl rand -base64 64
#
# IMPORTANT:
#   - JWT_SECRET and JWT_REFRESH_SECRET MUST be different
#   - Each should be 64+ characters
#   - Changing these will invalidate all existing user sessions!
# =============================================================================

JWT_SECRET=CHANGE_THIS_TO_64_CHAR_SECRET_MINIMUM_LENGTH_REQUIRED_HERE
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_64_CHAR_SECRET_HERE_PLEASE

# =============================================================================
# Server Configuration
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# Number of API server replicas (for horizontal scaling, requires Swarm/Compose v3)
# Set to 1 for single-server deployment
API_REPLICAS=1

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
# If not configured, email features will be disabled gracefully
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# =============================================================================
# S3/Object Storage (Optional - for production file storage)
# =============================================================================
# If not configured, files are stored locally in Docker volume (uploads_data)
# Local storage is fine for single-server deployments
# =============================================================================

# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=school-hub-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# =============================================================================
# Monitoring (Optional - enable with --profile with-logging)
# =============================================================================

# Grafana admin password - CHANGE THIS!
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_ADMIN_PASSWORD

# Grafana public URL (for links in alerts)
GRAFANA_ROOT_URL=https://yourdomain.com/grafana

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
# Place your SSL certificates in nginx/ssl/:
#   - fullchain.pem (certificate + intermediate)
#   - privkey.pem (private key)
#   - chain.pem (certificate chain for OCSP)
#
# For Let's Encrypt, use:
#   certbot certonly --standalone -d yourdomain.com
#   Then copy from /etc/letsencrypt/live/yourdomain.com/
#
# Or use the provided scripts/setup-ssl.sh helper
# =============================================================================

# =============================================================================
# SECURITY CHECKLIST - BEFORE DEPLOYING
# =============================================================================
# [ ] DB_PASSWORD is not the default (32+ chars, random)
# [ ] REDIS_PASSWORD is not the default (32+ chars, random)
# [ ] JWT_SECRET is 64+ characters, random
# [ ] JWT_REFRESH_SECRET is different from JWT_SECRET
# [ ] DOMAIN_NAME matches your actual domain
# [ ] API_BASE_URL uses HTTPS
# [ ] ALLOWED_ORIGINS includes your exact domain(s)
# [ ] GRAFANA_PASSWORD is changed
# [ ] SSL certificates are in nginx/ssl/
# [ ] .env file is NOT committed to git
# =============================================================================
