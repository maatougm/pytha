# Flutter Web Build Dockerfile
# Multi-stage build: build Flutter web app, then serve with nginx

# Stage 1: Build Flutter web app
FROM ghcr.io/cirruslabs/flutter:3.24.5 AS builder

WORKDIR /app

# Copy pubspec files
COPY pubspec.yaml ./

# Get dependencies
RUN flutter pub get

# Copy source code
COPY . .

# Copy pre-downloaded Flutter Web SDK if available
# This avoids network download issues
COPY flutter_web_sdk/ /usr/local/flutter/bin/cache/flutter_web_sdk/ 2>/dev/null || true

# Accept API_BASE_URL build argument
ARG API_BASE_URL=http://localhost:3000

# Build for web - skip download if SDK exists
RUN if [ -d "/usr/local/flutter/bin/cache/flutter_web_sdk" ]; then \
  echo "Using cached Flutter Web SDK"; \
  fi && \
  flutter build web --release --dart-define=API_BASE_URL=$API_BASE_URL

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built web app
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
