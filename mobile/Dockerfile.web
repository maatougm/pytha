# Flutter Web Build Dockerfile
# Multi-stage build: build Flutter web app, then serve with nginx

# Stage 1: Build Flutter web app
FROM ghcr.io/cirruslabs/flutter:3.24.5 AS builder

WORKDIR /app

# Copy pubspec files
COPY pubspec.yaml ./

# Get dependencies
RUN flutter pub get

# Copy source code
COPY . .

# Copy pre-downloaded Flutter Web SDK if available
# This avoids network download issues
COPY flutter_web_sd[k] /usr/local/flutter/bin/cache/flutter_web_sdk/

# Accept API_BASE_URL build argument (REQUIRED)
ARG API_BASE_URL=http://localhost:3000
ARG WS_BASE_URL=${API_BASE_URL}

# Validate that API_BASE_URL is set
RUN if [ "$API_BASE_URL" = "http://localhost:3000" ]; then \
  echo "WARNING: Using default API_BASE_URL. Make sure to set it in docker-compose.prod.yml"; \
  fi

# Build for web - skip download if SDK exists
RUN if [ -d "/usr/local/flutter/bin/cache/flutter_web_sdk" ]; then \
  echo "Using cached Flutter Web SDK"; \
  fi && \
  flutter build web --release \
  --dart-define=API_BASE_URL=$API_BASE_URL \
  --dart-define=WS_BASE_URL=$WS_BASE_URL

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built web app
COPY --from=builder /app/build/web /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
