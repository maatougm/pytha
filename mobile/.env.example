# School Hub Mobile App Environment Variables
# Copy this file to .env and update with your values

# ============================================================
# API CONFIGURATION
# ============================================================

# Base URL for API requests (no trailing slash)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# WebSocket URL for real-time messaging
EXPO_PUBLIC_WS_URL=http://localhost:3000

# ============================================================
# APP CONFIGURATION
# ============================================================

# App name displayed in UI
EXPO_PUBLIC_APP_NAME=School Hub

# App version (should match package.json)
EXPO_PUBLIC_APP_VERSION=1.0.0

# Environment: development, staging, production
EXPO_PUBLIC_ENV=development

# ============================================================
# FEATURE FLAGS
# ============================================================

# Enable/disable biometric authentication
EXPO_PUBLIC_ENABLE_BIOMETRIC=true

# Enable/disable push notifications
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# Enable/disable analytics
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# ============================================================
# DEVELOPMENT SETTINGS
# ============================================================

# Enable debug logging
EXPO_PUBLIC_DEBUG=false

# Mock API responses (for development without backend)
EXPO_PUBLIC_MOCK_API=false

# ============================================================
# PRODUCTION SETTINGS (Only for production builds)
# ============================================================

# Sentry DSN for error tracking (optional)
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Analytics API key (optional)
# EXPO_PUBLIC_ANALYTICS_KEY=xxx
